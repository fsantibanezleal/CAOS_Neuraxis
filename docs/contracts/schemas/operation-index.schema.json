{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuraxis.ml.fasl-work.com/contracts/operation-index.schema.json",
  "title": "Neuraxis compound operation study index",
  "type": "object",
  "required": ["schema_version", "boundary", "engine", "policy", "runs"],
  "properties": {
    "schema_version": { "const": 1 },
    "boundary": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["run_id", "task", "variant", "seed", "status", "path", "sha256", "findings", "wall_ms"],
        "properties": {
          "run_id": { "type": "string" },
          "task": { "type": "string" },
          "variant": { "type": "string" },
          "seed": { "type": "integer" },
          "status": { "type": "string" },
          "path": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "findings": { "type": "integer", "minimum": 0 },
          "wall_ms": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
