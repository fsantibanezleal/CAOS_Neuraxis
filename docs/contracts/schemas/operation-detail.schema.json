{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuraxis.ml.fasl-work.com/contracts/operation-detail.schema.json",
  "title": "Neuraxis measured operation run",
  "type": "object",
  "required": ["schema_version", "scope", "engine", "task", "policy", "status", "disposition", "inputs", "artifacts", "events", "nodes", "findings", "metrics", "input_sha256"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "task": { "type": "string" },
    "scope": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "minLength": 1 },
    "status": { "type": "string" },
    "disposition": { "type": "string" },
    "inputs": { "type": "array" },
    "artifacts": {
      "type": "object",
      "required": ["integrity", "inventory", "manifest", "report", "verify"],
      "properties": {
        "dependencies": { "type": "object" },
        "integrity": { "type": "object" },
        "inventory": { "type": "object" },
        "manifest": { "type": "object" },
        "normalize": { "type": "object" },
        "report": { "type": "object" },
        "syntax": { "type": "object" },
        "verify": { "type": "object" }
      },
      "additionalProperties": true
    },
    "events": { "type": "array" },
    "nodes": { "type": "array" },
    "findings": { "type": "array" },
    "metrics": { "type": "object" },
    "input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
