{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuraxis.ml.fasl-work.com/contracts/semantic-index.schema.json",
  "title": "Neuraxis semantic transfer index",
  "type": "object",
  "required": ["schema_version", "provenance", "methods", "cases", "episodes", "aggregate_results"],
  "properties": {
    "schema_version": { "const": 1 },
    "provenance": { "type": "object", "required": ["split", "lineage", "lineage_signature"] },
    "methods": { "type": "array", "minItems": 12 },
    "cases": { "type": "array", "minItems": 8 },
    "episodes": { "type": "array", "minItems": 1536, "items": { "$ref": "canonical-index.schema.json#/$defs/episodeReference" } },
    "aggregate_results": { "type": "array", "minItems": 12 }
  },
  "additionalProperties": true
}
