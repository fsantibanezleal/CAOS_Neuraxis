{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuraxis.ml.fasl-work.com/contracts/product.schema.json",
  "title": "Neuraxis product identity",
  "type": "object",
  "required": [
    "name",
    "slug",
    "version",
    "tagline",
    "repo",
    "visibility",
    "license",
    "holder",
    "year",
    "method_packages",
    "method_entrypoints"
  ],
  "properties": {
    "name": {
      "const": "Neuraxis"
    },
    "slug": {
      "const": "neuraxis"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "tagline": {
      "type": "object",
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 20
        },
        "es": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": false
    },
    "repo": {
      "const": "https://github.com/fsantibanezleal/CAOS_Neuraxis"
    },
    "visibility": {
      "const": "public"
    },
    "license": {
      "const": "Apache-2.0"
    },
    "holder": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 2026
    },
    "method_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "method_entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
      }
    },
    "manuscripts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "concept_doi",
          "title",
          "version",
          "covers"
        ],
        "properties": {
          "kind": {
            "enum": [
              "technical-report",
              "manuscript"
            ]
          },
          "concept_doi": {
            "type": "string",
            "pattern": "^10\\.5281/zenodo\\.[1-9][0-9]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^BS-[0-9]+$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
