{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation-run.schema.json",
  "title": "Operation run",
  "description": "Catalog row operation-run 1.0.0: one recorded run of the compound file-operation suite, written by scripts/evaluate_operations.py:35 from the dict `execute_operation` (app/services/operations.py:561) returns, and the `result` of the live API snapshot. Per-task artifacts (inventory, integrity, manifest, syntax, tables, normalize, dependencies, report, verify) are present only for the tasks that run them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts",
    "disposition",
    "engine",
    "events",
    "findings",
    "input_sha256",
    "inputs",
    "metrics",
    "nodes",
    "policy",
    "schema_version",
    "scope",
    "status",
    "task"
  ],
  "properties": {
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findings",
            "job_count",
            "jobs",
            "workflows"
          ],
          "properties": {
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "line",
                  "message",
                  "path",
                  "severity"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "line": {
                    "type": "null"
                  },
                  "message": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  }
                }
              }
            },
            "job_count": {
              "type": "integer"
            },
            "jobs": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "propertyNames": {
                "pattern": "^.+::.+$"
              }
            },
            "workflows": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checks",
            "findings",
            "manifest_present"
          ],
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actual",
                  "expected",
                  "match",
                  "path"
                ],
                "properties": {
                  "actual": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "expected": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "match": {
                    "type": "boolean"
                  },
                  "path": {
                    "type": "string"
                  }
                }
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actual",
                  "code",
                  "expected",
                  "line",
                  "message",
                  "path",
                  "severity"
                ],
                "properties": {
                  "actual": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "code": {
                    "type": "string"
                  },
                  "expected": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "line": {
                    "type": "null"
                  },
                  "message": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  }
                }
              }
            },
            "manifest_present": {
              "type": "boolean"
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "findings",
            "total_bytes"
          ],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bytes",
                  "kind",
                  "path",
                  "sha256"
                ],
                "properties": {
                  "bytes": {
                    "type": "integer"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "findings": {
              "type": "array"
            },
            "total_bytes": {
              "type": "integer"
            }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "files",
            "findings"
          ],
          "properties": {
            "algorithm": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "findings": {
              "type": "array"
            }
          }
        },
        "normalize": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findings",
            "outputs"
          ],
          "properties": {
            "findings": {
              "type": "array"
            },
            "outputs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accepted_rows",
                  "content",
                  "rejected",
                  "rejected_rows"
                ],
                "properties": {
                  "accepted_rows": {
                    "type": "integer"
                  },
                  "content": {
                    "type": "string"
                  },
                  "rejected": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Rejected"
                    }
                  },
                  "rejected_rows": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checks_performed",
            "controller",
            "disposition",
            "file_count",
            "findings",
            "model_calls",
            "originals_changed",
            "scope",
            "table_policy"
          ],
          "properties": {
            "checks_performed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "controller": {
              "type": "string"
            },
            "disposition": {
              "type": "string"
            },
            "file_count": {
              "type": "integer"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Findings"
              }
            },
            "model_calls": {
              "type": "integer"
            },
            "originals_changed": {
              "type": "boolean"
            },
            "scope": {
              "type": "string"
            },
            "table_policy": {
              "type": "string"
            }
          }
        },
        "syntax": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checked",
            "findings"
          ],
          "properties": {
            "checked": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "valid"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "valid": {
                    "type": "boolean"
                  }
                }
              }
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "line",
                  "message",
                  "path",
                  "severity"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "tables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "findings",
            "relationships",
            "tables"
          ],
          "properties": {
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "line",
                  "message",
                  "path",
                  "severity"
                ],
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "line": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  }
                }
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "column",
                  "path",
                  "status",
                  "target"
                ],
                "properties": {
                  "column": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "target": {
                    "type": "string"
                  }
                }
              }
            },
            "tables": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accepted",
                  "headers",
                  "rejected"
                ],
                "properties": {
                  "accepted": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "end_line",
                        "extra_values",
                        "line",
                        "reasons",
                        "record",
                        "values"
                      ],
                      "properties": {
                        "end_line": {
                          "type": "integer"
                        },
                        "extra_values": {
                          "type": "array"
                        },
                        "line": {
                          "type": "integer"
                        },
                        "reasons": {
                          "type": "array"
                        },
                        "record": {
                          "type": "integer"
                        },
                        "values": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "headers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rejected": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Rejected"
                    }
                  }
                }
              }
            }
          }
        },
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checks",
            "findings",
            "passed"
          ],
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "passed"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "passed": {
                    "type": "boolean"
                  }
                }
              }
            },
            "findings": {
              "type": "array"
            },
            "passed": {
              "type": "boolean"
            }
          }
        }
      },
      "description": "The per-task outputs, keyed by task step."
    },
    "disposition": {
      "type": "string",
      "enum": [
        "checks_passed",
        "attention_required",
        "incomplete"
      ]
    },
    "engine": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "elapsed_ms",
          "kind",
          "sequence"
        ],
        "properties": {
          "decision": {
            "$ref": "#/$defs/Decision"
          },
          "effect_rollback_claimed": {
            "type": "boolean"
          },
          "elapsed_ms": {
            "type": "number"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/Evidence"
          },
          "goal_id": {
            "type": "string"
          },
          "intent_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "tool_started",
              "tool_finished",
              "goal_state",
              "goal_cancel"
            ]
          },
          "node": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "description": "The ordered journal of decisions, tool starts, tool finishes and goal states."
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Findings"
      },
      "description": "Every finding of the run (code, path, message, severity, line); the disposition is attention_required when there is one."
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the input bundle."
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content",
          "path"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "description": "The files the run read (path and content), the bundle the digest covers."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency",
        "files",
        "journal_sequence",
        "model_calls",
        "native_receipts",
        "verified_nodes",
        "wall_ms"
      ],
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "files": {
          "type": "integer"
        },
        "journal_sequence": {
          "type": "integer"
        },
        "model_calls": {
          "type": "integer"
        },
        "native_receipts": {
          "type": "integer"
        },
        "verified_nodes": {
          "type": "integer"
        },
        "wall_ms": {
          "type": "number"
        }
      },
      "description": "Counters of the run; identical to the matching row of the operation index."
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "depends_on",
          "error",
          "history",
          "id",
          "output",
          "state",
          "title"
        ],
        "properties": {
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "decision": {
                  "$ref": "#/$defs/Decision"
                },
                "event_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "receipt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "accepted_ms",
                    "cancellation_requested",
                    "expires_ms",
                    "finished_ms",
                    "intent",
                    "invalidation_reason",
                    "outcome",
                    "started_ms",
                    "status"
                  ],
                  "properties": {
                    "accepted_ms": {
                      "type": "integer"
                    },
                    "cancellation_requested": {
                      "type": "boolean"
                    },
                    "expires_ms": {
                      "type": "integer"
                    },
                    "finished_ms": {
                      "type": "integer"
                    },
                    "intent": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "action_id",
                        "action_version",
                        "arguments",
                        "idempotency_key",
                        "intent_id",
                        "resources",
                        "ttl_ms"
                      ],
                      "properties": {
                        "action_id": {
                          "type": "string"
                        },
                        "action_version": {
                          "type": "integer"
                        },
                        "arguments": {
                          "type": "object"
                        },
                        "idempotency_key": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "intent_id": {
                          "type": "string"
                        },
                        "resources": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "access",
                              "expected_revision",
                              "resource_id"
                            ],
                            "properties": {
                              "access": {
                                "type": "string"
                              },
                              "expected_revision": {
                                "type": "integer"
                              },
                              "resource_id": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "ttl_ms": {
                          "type": "integer"
                        }
                      }
                    },
                    "invalidation_reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "outcome": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": false,
                      "required": [
                        "changed_resources",
                        "evidence",
                        "resource_fingerprints",
                        "status"
                      ],
                      "properties": {
                        "changed_resources": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "evidence": {
                          "$ref": "#/$defs/Evidence"
                        },
                        "resource_fingerprints": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          "propertyNames": {
                            "pattern": "^file:.+$"
                          }
                        },
                        "status": {
                          "type": "string"
                        }
                      }
                    },
                    "started_ms": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                },
                "revision": {
                  "type": "integer"
                }
              }
            }
          },
          "id": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "es"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "es": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "The task graph: each node with its dependencies, state, native receipts and bilingual title."
    },
    "policy": {
      "type": "string",
      "enum": [
        "verified-operation-fsm"
      ]
    },
    "schema_version": {
      "enum": [
        1
      ]
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "task": {
      "type": "string",
      "enum": [
        "data",
        "release",
        "source"
      ]
    }
  },
  "$defs": {
    "Decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "confidence",
        "diagnostics",
        "mode",
        "policy_id",
        "reason",
        "scores"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "diagnostics": {
          "type": "object"
        },
        "mode": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "scores": {
          "type": "object"
        }
      }
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "duration_ms",
        "findings",
        "path",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer"
        },
        "duration_ms": {
          "type": "number"
        },
        "findings": {
          "type": "integer"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "Findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "line",
        "message",
        "path",
        "severity"
      ],
      "properties": {
        "actual": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code": {
          "type": "string"
        },
        "expected": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      }
    },
    "Rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_line",
        "extra_values",
        "line",
        "reasons",
        "record",
        "values"
      ],
      "properties": {
        "end_line": {
          "type": "integer"
        },
        "extra_values": {
          "type": "array"
        },
        "line": {
          "type": "integer"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "record": {
          "type": "integer"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
