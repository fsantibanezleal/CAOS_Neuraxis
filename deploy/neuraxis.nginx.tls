server {
    listen 80;
    server_name neuraxis.ml.fasl-work.com;
    location /.well-known/acme-challenge/ { root /var/www/neuraxis.ml.fasl-work.com/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name neuraxis.ml.fasl-work.com;
    ssl_certificate /etc/letsencrypt/live/neuraxis.ml.fasl-work.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/neuraxis.ml.fasl-work.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/neuraxis.ml.fasl-work.com/current;
    index index.html;
    gzip on;
    gzip_vary on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    location / { try_files $uri $uri/ /index.html; }
    location /data/ { try_files $uri =404; add_header Cache-Control "public, max-age=300"; }
    location /assets/ { try_files $uri =404; add_header Cache-Control "public, max-age=31536000, immutable"; }
    location /api/ { return 404; }
    location /operations/ { try_files $uri =404; add_header Cache-Control "public, max-age=300"; }
    location /operations-api/ {
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:8174;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 65s;
    }
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
}
