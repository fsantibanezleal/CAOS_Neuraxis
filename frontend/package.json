{
  "name": "neuraxis-frontend",
  "private": true,
  "version": "0.2.13",
  "type": "module",
  "scripts": {
    "predev": "node copy-data.mjs",
    "dev": "vite",
    "prebuild": "node copy-data.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gate": "node shell-gate.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" vite.config.ts"
  },
  "dependencies": {
    "@fasl-work/caos-app-shell": "0.19.5",
    "i18next": "^26.4.2",
    "katex": "0.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.14",
    "react-router": "7.18.4",
    "react-router-dom": "^7.18.4",
    "uplot": "1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.8",
    "typescript": "^5.7.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
